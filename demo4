# When using LAMMPS-GUI in your project, please cite: https://arxiv.org/abs/2503.14020

# 1) Initialization

# https://docs.lammps.org/dimension.html
units nano
# How do I convert these?
# 1 m = 1E9 nm
# 1 s = 1E9 ns
# 1 kg = 1E18 attograms
# 1 N = kg*m/(s2) = E18 * 1E9 / (E18) = 1E9 attogram-nanometer/nanosecond^2 
# 1 J = N*m = 1E18 attogram-nm2/ns2
# 1 N/m = 1 attogram/nanosecond^2 
# 1 Pa = 1 N/m = 1E9 attogram/(nanometer-nanosecond^2)
dimension 2
atom_style angle
boundary p p p

#### 2) System definition

# https://docs.lammps.org/read_data.html
# https://docs.lammps.org/Run_formats.html#data-file
read_data network1.data

#### 3) Pair/Bond/Angle Settings
variable up equal 0.1E-1
variable prescribed_strain equal 1 + ${up}

# Set pair_style, required for bonds
pair_style zero 5 # zero = no interactions, distance to consider neighbors
pair_coeff * *    # This non-existant pairs should exist between all types

# Extension Components
bond_style hybrid harmonic nonlinear
bond_coeff 1 harmonic 5.570 1.03              # Xaoxuan 2024, Nguyen 2015
bond_coeff 2 nonlinear 0.1709 0.9065 4.0878   # Curve fit to WLC in Nguyen 2015

# Bending Component :: https://docs.lammps.org/angle_harmonic.html
angle_style harmonic
angle_coeff 1 4.18E-2 180.0 # btype, K (E/rad^2), theta0 (deg). Note: K is placeholder from slides

#### 4) Monitoring
thermo_style custom step etotal pe temp
thermo 1 # every iteration

# Output visual snapshots of the system
# https://docs.lammps.org/dump_image.html 
dump 1 all image 5000 dump.*.jpg type type bond type type atom no

### 5) Minimize the energy before any deformation is applied
minimize 1.0e-6 1.0e-6 2000 10000

# output undeformed State
variable p_step equal step # variables need to be defined for printing values
variable p_PE equal pe
variable p_lx equal lx
variable p_ly equal ly
variable p_xy equal xy
print "step pe lx ly xy" file energy_deformation.data
print "${p_step} ${p_PE} ${p_lx} ${p_ly} ${p_xy}" append energy_deformation.data

compute 1 all property/local btype batom1 batom2
compute 2 all bond/local dist fx fy fz
run 0
write_dump all local bond_state_0.dump index c_1[1] c_1[2] c_1[3] c_2[1] c_2[2] c_2[3] c_2[4]
write_dump all custom atom_state_0.dump id mol type x y
uncompute 1
uncompute 2

### 6) Prescribe strain, let positions and velocities update

# Deformation specification
fix 1 all nve                   # Forces from bonds will result in motion 
fix 2 all deform 1 x scale ${prescribed_strain} units box remap none # Box deforms, do we want to remap velocity? remap v
#fix 2 all deform 10 xy delta 5 units box remap none # Box deforms, do we want to remap velocity? remap v

# Output of system-level parameters that can be used to compute stress
# https://docs.lammps.org/fix_print.html
# fix 3 all print 1000 "${p_step} ${p_PE} ${p_lx} ${p_ly} ${p_xy}" append energy_deformation.data

# Very slowly apply the strain to prevent energy accumulation
run 200000

### 7) Minimize energy of deformed state
minimize 1.0e-6 1.0e-6 2000 10000

# https://docs.lammps.org/compute_bond_local.html
### 8) Output for Python
print "${p_step} ${p_PE} ${p_lx} ${p_ly} ${p_xy}" append energy_deformation.data
compute 1 all property/local btype batom1 batom2
compute 2 all bond/local dist fx fy fz
run 0 # Computation happens at this step
write_dump all local bond_state.dump index c_1[1] c_1[2] c_1[3] c_2[1] c_2[2] c_2[3] c_2[4]
write_dump all custom atom_state.dump id mol type x y

